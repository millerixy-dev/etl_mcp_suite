{
  "version": 1,
  "plugin": "spark",
  "settings": {
    "history_server_url": "https://history.example.invalid:8443/gateway/analytics/sparkhistory",
    "cache_dir": "/var/tmp/mcp-spark-l3",
    "executor_log_node_manager_path": "/yarn/nodemanager/node",
